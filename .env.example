# Copy to .env and edit. Every variable is optional; defaults are shown.
# The spending rules themselves live in spend_policy.toml, not here.

APP_NAME=agent-spend-guard
POLICY_FILE=./spend_policy.toml
DATA_DIR=./data
DATABASE_URL=                # empty = sqlite in DATA_DIR
SEED_ON_STARTUP=true
OPENING_BALANCE=5000.00      # mock wallet balance when first created

# Human approval over HTTP. Empty = confirm/deny only via the CLI (local operator).
# Agents must never be given this token.
APPROVER_TOKEN=

# Payments: Stripe TEST mode only (sk_test_...). Empty = mock wallet. Live keys are refused.
STRIPE_SECRET_KEY=

# Demo agent (LLM). Leave GROQ_API_KEY empty to use the scripted agent.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
AGENT_MAX_STEPS=8
